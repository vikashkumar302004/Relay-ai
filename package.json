{
  "name": "relay",
  "version": "1.4.0",
  "author": "Vikash Kumar",
  "license": "MIT",
  "description": "Local-first AI continuity tool for carrying useful context between providers",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "check": "node --check main.js && node --check preload.js && node --check sessions.js",
    "test": "node --test tests/*.test.js",
    "test:visual": "electron tests/visual-smoke.js",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder --win",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.relay.ai",
    "productName": "Relay",
    "artifactName": "Relay-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/tray-icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**",
      "main.js",
      "preload.js",
      "sessions.js",
      "assets/**",
      "node_modules/**"
    ]
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0"
  }
}
